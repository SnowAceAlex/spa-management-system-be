generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_PAID
  REFUNDED
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
}

enum RewardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
}

enum NotificationType {
  APPOINTMENT_REMINDER
  APPOINTMENT_CONFIRMATION
  APPOINTMENT_CANCELLATION
  LOYALTY_POINTS_EARNED
  LOYALTY_REWARD_UNLOCKED
  PROMOTION
}

enum DiscountType {
  PERCENTAGE
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  role         Role           @default(CUSTOMER)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  refreshTokens RefreshToken[]
  customer      Customer?
  staff         Staff?
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
}

model Customer {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  phone       String?   @unique
  dateOfBirth DateTime?
  notes       String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  appointments     Appointment[]
  loyaltyAccount   LoyaltyAccount?
  reviews          Review[]
  notifications    Notification[]
}

model Staff {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  phone       String?
  bio         String?
  isAvailable Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  specializations StaffSpecialization[]
  schedules       StaffSchedule[]
  appointments    Appointment[]
  reviews         Review[]
}

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  services    Service[]
}

model Service {
  id          String          @id @default(cuid())
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id])

  name        String
  description String?
  durationMin Int
  price       Decimal         @db.Decimal(10, 2)
  imageUrl    String?
  isActive    Boolean         @default(true)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  staffSpecializations StaffSpecialization[]
  appointmentServices  AppointmentService[]
  reviews              Review[]
}

model StaffSpecialization {
  id        String  @id @default(cuid())
  staffId   String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
}

model StaffSchedule {
  id           String  @id @default(cuid())
  staffId      String
  staff        Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  dayOfWeek    Int
  startTime    String
  endTime      String
  isWorkingDay Boolean @default(true)

  @@unique([staffId, dayOfWeek])
}

model Appointment {
  id            String            @id @default(cuid())
  customerId    String
  customer      Customer          @relation(fields: [customerId], references: [id])
  staffId       String
  staff         Staff             @relation(fields: [staffId], references: [id])

  scheduledAt   DateTime
  endsAt        DateTime
  status        AppointmentStatus @default(PENDING)
  notes         String?

  totalAmount   Decimal           @db.Decimal(10, 2) @default(0)
  paymentStatus PaymentStatus     @default(UNPAID)

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  services      AppointmentService[]
  invoice       Invoice?
  review        Review?
}

model AppointmentService {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id])

  priceSnapshot Decimal     @db.Decimal(10, 2)
  durationMin   Int

  @@unique([appointmentId, serviceId])
}

model Invoice {
  id            String        @id @default(cuid())
  appointmentId String        @unique
  appointment   Appointment   @relation(fields: [appointmentId], references: [id])

  subtotal      Decimal       @db.Decimal(10, 2)
  discountAmt   Decimal       @db.Decimal(10, 2) @default(0)
  taxAmt        Decimal       @db.Decimal(10, 2) @default(0)
  totalAmt      Decimal       @db.Decimal(10, 2)
  paidAmt       Decimal       @db.Decimal(10, 2) @default(0)
  paymentStatus PaymentStatus @default(UNPAID)
  paidAt        DateTime?

  pointsUsed    Int           @default(0)
  pointsEarned  Int           @default(0)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  loyaltyTransactions LoyaltyTransaction[]
}

model LoyaltyAccount {
  id             String   @id @default(cuid())
  customerId     String   @unique
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  totalPoints    Int      @default(0)
  lifetimePoints Int      @default(0)
  tier           LoyaltyTier @default(BRONZE)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions LoyaltyTransaction[]
  rewards      CustomerReward[]
}

model LoyaltyTransaction {
  id               String                 @id @default(cuid())
  loyaltyAccountId String
  loyaltyAccount   LoyaltyAccount         @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  invoiceId        String?
  invoice          Invoice?               @relation(fields: [invoiceId], references: [id])

  type             LoyaltyTransactionType
  points           Int
  balanceAfter     Int
  description      String?

  createdAt        DateTime               @default(now())
}

model LoyaltyReward {
  id            String   @id @default(cuid())
  name          String
  description   String?
  pointsCost    Int
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Decimal  @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
  validDays     Int      @default(30)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customerRewards CustomerReward[]
}

model CustomerReward {
  id               String         @id @default(cuid())
  loyaltyAccountId String
  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  rewardId         String
  reward           LoyaltyReward  @relation(fields: [rewardId], references: [id])

  status           RewardStatus   @default(ACTIVE)
  expiresAt        DateTime
  redeemedAt       DateTime?

  createdAt        DateTime       @default(now())
}

model Review {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  staffId       String
  staff         Staff       @relation(fields: [staffId], references: [id])
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id])

  rating        Int
  comment       String?
  isPublic      Boolean     @default(true)

  createdAt     DateTime    @default(now())
}

model Promotion {
  id            String    @id @default(cuid())
  name          String
  description   String?
  code          String?   @unique
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Decimal   @db.Decimal(10, 2)
  minSpend      Decimal?  @db.Decimal(10, 2)
  maxUses       Int?
  usedCount     Int       @default(0)
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean   @default(true)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Notification {
  id         String           @id @default(cuid())
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type       NotificationType
  title      String
  body       String
  isRead     Boolean          @default(false)
  sentAt     DateTime?

  createdAt  DateTime         @default(now())
}